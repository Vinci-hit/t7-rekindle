<Window x:Class="T7.Rekindle.Desktop.Views.PreviewAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views"
        Title="预览渠道离线授权" Width="640" Height="680" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/T7-Rekindle;component/Resources/Assets/brand/launcher.ico"
        FontFamily="{StaticResource UiFontFamily}" FontSize="16" Language="zh-CN"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}" KeyboardNavigation.TabNavigation="Cycle">
  <Grid Margin="28" Background="{DynamicResource PanelBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:Icon Kind="lock" Width="28" Height="28" Foreground="{DynamicResource WarningBrush}" Margin="0,0,14,0" />
      <TextBlock Text="预览渠道离线授权" FontSize="24" FontWeight="SemiBold" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="{Binding RiskText}" TextWrapping="Wrap" Margin="0,0,0,14" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14" />
        <Label Content="1. 将申请码发给管理员" Target="{Binding ElementName=RequestCodeBox}" />
        <TextBox x:Name="RequestCodeBox" Text="{Binding RequestCode, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 AutomationProperties.Name="本机当前用户的申请码" TabIndex="0" MinHeight="58" />
        <Button Content="复制申请码" Command="{Binding CopyRequestCommand}" HorizontalAlignment="Left" Margin="0,8,0,12"
                AutomationProperties.Name="复制申请码" TabIndex="1" />
        <Label Content="2. 粘贴管理员签发的授权码" Target="{Binding ElementName=GrantCodeBox}" />
        <TextBox x:Name="GrantCodeBox" Text="{Binding GrantCode, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                 AcceptsReturn="False" MaxLength="4096" Height="106" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="预览授权码" AutomationProperties.HelpText="粘贴完整离线签名授权码，不是六位动态验证码" TabIndex="2" />
        <TextBlock Text="授权仅适用于当前电脑和 Windows 用户，自签发起 7 天有效。验证并切换表示确认上述预览风险。"
                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
        <TextBlock x:Name="ErrorText" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                   AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </ScrollViewer>
    <views:ToastHost x:Name="CopyToastHost" Grid.Row="1" Panel.ZIndex="20" VerticalAlignment="Top" Margin="0,18,0,0" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="取消" IsCancel="True" IsDefault="True" MinWidth="100" Margin="0,0,12,0"
              AutomationProperties.Name="取消" TabIndex="3" />
      <Button x:Name="AuthorizeButton" Content="验证并切换" Command="{Binding AuthorizeCommand}" MinWidth="136"
              AutomationProperties.Name="验证并切换" TabIndex="4" />
    </StackPanel>
  </Grid>
</Window>
