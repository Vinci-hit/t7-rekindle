<Window x:Class="T7R.Desktop.Views.TitlesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="我的称号" Width="520" Height="600" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/T7-Rekindle;component/Resources/Assets/brand/launcher.ico"
        FontSize="14" Language="zh-CN" KeyboardNavigation.TabNavigation="Cycle"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource LoginMenuBrush}" Foreground="{DynamicResource LoginInkBrush}"
        FontFamily="{StaticResource UiFontFamily}">
  <Grid Margin="24" Background="{DynamicResource LoginMenuBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="我的称号" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding EquippedTitle, StringFormat=当前佩戴：{0}}" Margin="0,8,0,0"/><TextBlock Text="{Binding TitleStatus}" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanChangeTitle}">
      <ItemsControl x:Name="TitleItems" ItemsSource="{Binding Titles}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Padding="14" Margin="0,0,0,12" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource LoginMenuBorderBrush}">
          <StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StateText}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Rule}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <Button Content="佩戴" Tag="{Binding TitleId}" Click="OnEquip" HorizontalAlignment="Left" Padding="16,5" IsEnabled="{Binding CanEquip}"
                    AutomationProperties.Name="{Binding Name, StringFormat=佩戴称号：{0}}" TabIndex="0"/>
          </StackPanel>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="UnequipButton" Content="卸下称号" Click="OnUnequip" IsEnabled="{Binding CanChangeTitle}" Padding="12,6" Margin="0,0,12,0"
              AutomationProperties.Name="卸下称号" TabIndex="1"/>
      <Button x:Name="CloseButton" Content="关闭" IsCancel="True" Padding="12,6" AutomationProperties.Name="关闭称号窗口" TabIndex="2"/>
    </StackPanel>
  </Grid>
</Window>
