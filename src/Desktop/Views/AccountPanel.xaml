<UserControl x:Class="T7.Rekindle.Desktop.Views.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="156" Height="44">
  <Grid>
    <ToggleButton x:Name="AccountToggle" Margin="0,2,8,2" Padding="8,3" Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                  AutomationProperties.Name="账号登录与在线状态" ToolTip="{Binding Status}">
      <DockPanel>
        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource HoverBrush}" Margin="0,0,8,0">
          <Grid><TextBlock Text="QQ" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Image Source="{Binding AvatarUrl, NotifyOnTargetUpdated=True}" Stretch="UniformToFill" ImageFailed="OnAvatarFailed" TargetUpdated="OnAvatarChanged" />
          </Grid>
        </Border>
        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </ToggleButton>
    <Popup x:Name="AccountPopup" IsOpen="{Binding IsChecked, ElementName=AccountToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AccountToggle}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
              Padding="20" Width="310" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding QqNumber, StringFormat=QQ：{0}}" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVisibility}}"
                     Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,16" />
          <Button Content="QQ 扫码登录" Command="{Binding LoginCommand}" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}"
                  AutomationProperties.Name="QQ 扫码登录" TabIndex="0" />
          <Button Content="重新上线" Command="{Binding ReconnectCommand}" Margin="0,8,0,0" Visibility="{Binding CanReconnect, Converter={StaticResource BoolVisibility}}"
                  AutomationProperties.Name="重新上线" TabIndex="1" />
          <Button Content="退出登录" Command="{Binding LogoutCommand}" Margin="0,8,0,0" Visibility="{Binding HasSession, Converter={StaticResource BoolVisibility}}"
                  AutomationProperties.Name="退出登录" TabIndex="2" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
