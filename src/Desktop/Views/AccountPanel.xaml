<UserControl x:Class="T7.Rekindle.Desktop.Views.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36" VerticalAlignment="Center" FontFamily="{StaticResource UiFontFamily}"
             DataContextChanged="OnAccountChanged">
  <Grid Background="Transparent">
    <ToggleButton x:Name="AccountToggle" Checked="OnAccountChecked" Unchecked="OnAccountUnchecked" TabIndex="0"
                  ToolTip="{Binding AccountHint}" AutomationProperties.HelpText="{Binding Status}"
                  AutomationProperties.Name="未登录，打开 QQ 登录页">
      <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource AccountCapsule}">
        <Style.Triggers><DataTrigger Binding="{Binding IsOpen, ElementName=AccountPopup}" Value="True">
          <Setter Property="IsHitTestVisible" Value="False" />
        </DataTrigger></Style.Triggers>
      </Style></ToggleButton.Style>
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}">
          <ProgressBar x:Name="GuestLoadingIndicator" Style="{StaticResource AccountLoadingIndicator}"
                       Margin="0,0,6,0" AutomationProperties.Name="{Binding Status}" />
          <TextBlock x:Name="GuestLabel" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Text" Value="未登录" />
              <Style.Triggers><DataTrigger Binding="{Binding IsWaitingForServer}" Value="True">
                <Setter Property="Text" Value="登录中" />
              </DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Grid x:Name="MemberContent" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="PresenceDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
            <Ellipse.Style><Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource AccountOfflineDotBrush}" />
              <Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource AccountOnlineDotBrush}" />
              </DataTrigger></Style.Triggers>
            </Style></Ellipse.Style>
          </Ellipse>
          <Border Grid.Column="1" Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0"
                  Background="{DynamicResource LoginAvatarBrush}">
            <Grid>
              <Control Style="{StaticResource LoginGlyph}" Tag="{StaticResource LoginIcon.User}" Width="16" Height="16" />
              <Image x:Name="CapsuleAvatar" Source="{Binding AvatarUrl, NotifyOnTargetUpdated=True}" Stretch="UniformToFill"
                     ImageFailed="OnAvatarFailed" TargetUpdated="OnAvatarChanged" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Clip><RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6" /></Image.Clip>
              </Image>
              <Border BorderBrush="{DynamicResource LoginAvatarBorderBrush}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" />
            </Grid>
          </Border>
          <TextBlock Grid.Column="2" x:Name="CapsuleNickname" Text="{Binding DisplayName}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <Grid Grid.Column="3" Width="14" Height="14" Margin="8,0,0,0">
            <Control x:Name="AccountChevron" Tag="{StaticResource LoginIcon.Chevron}"
                     Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
              <Control.Style><Style TargetType="Control" BasedOn="{StaticResource LoginGlyph}">
                <Setter Property="Opacity" Value="0.72" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsWaitingForServer}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=AccountToggle}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style></Control.Style>
            </Control>
            <ProgressBar x:Name="MemberLoadingIndicator" Style="{StaticResource AccountLoadingIndicator}"
                         AutomationProperties.Name="{Binding Status}" />
          </Grid>
        </Grid>
      </Grid>
    </ToggleButton>
    <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountToggle}" Placement="Custom"
           StaysOpen="False" AllowsTransparency="True" Opened="OnMenuOpened" Closed="OnMenuClosed">
      <Border Background="Transparent" Padding="30,8,30,40" PreviewKeyDown="OnMenuKeyDown">
        <Grid>
          <Border Background="{DynamicResource LoginMenuBrush}" CornerRadius="10" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#182527" Opacity="0.20" BlurRadius="30" ShadowDepth="15" Direction="270" /></Border.Effect>
          </Border>
          <Border Background="{DynamicResource LoginMenuBrush}" CornerRadius="10" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#182527" Opacity="0.10" BlurRadius="7" ShadowDepth="3" Direction="270" /></Border.Effect>
          </Border>
          <Border x:Name="AccountMenu" Width="280" MinHeight="58" Padding="12" CornerRadius="10"
                  Background="{DynamicResource LoginMenuBrush}" BorderBrush="{DynamicResource LoginMenuBorderBrush}" BorderThickness="1">
            <Grid KeyboardNavigation.TabNavigation="Cycle">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource LoginAvatarBrush}">
                <Grid>
                  <Control Style="{StaticResource LoginGlyph}" Tag="{StaticResource LoginIcon.User}" Width="20" Height="20" Foreground="{DynamicResource LoginInkBrush}" />
                  <Image x:Name="MenuAvatar" Source="{Binding AvatarUrl, NotifyOnTargetUpdated=True}" Stretch="UniformToFill"
                         ImageFailed="OnAvatarFailed" TargetUpdated="OnAvatarChanged" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip><RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" /></Image.Clip>
                  </Image>
                  <Border BorderBrush="{DynamicResource LoginAvatarBorderBrush}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" />
                </Grid>
              </Border>
              <Grid Grid.Column="1" Margin="10,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="AccountNickname" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                           FontSize="14" FontWeight="Medium" Foreground="{DynamicResource LoginTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" x:Name="AccountNumber" Text="{Binding QqNumber, StringFormat=（{0}）}"
                           FontSize="12" Foreground="{DynamicResource LoginMutedBrush}"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Grid>
              <Button Grid.Column="2" x:Name="LogoutButton" Click="OnLogout" Style="{StaticResource LoginLogoutButton}"
                      ToolTip="退出登录" AutomationProperties.Name="退出登录" TabIndex="0">
                <Control Style="{StaticResource LoginGlyph}" Tag="{StaticResource LoginIcon.Logout}" />
              </Button>
            </Grid>
          </Border>
          <Border Margin="1" CornerRadius="9" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LoginHighlightBrush}" IsHitTestVisible="False" />
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
