<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="AccountLoadingIndicator" TargetType="ProgressBar">
    <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource AccountInkBrush}" />
    <Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="IsIndeterminate" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
      <Grid>
        <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" Opacity="0.18" Margin="1" />
        <Grid x:Name="Rotor" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
          <Path Data="M7,1 A6,6 0 1 1 1,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>
      </Grid>
      <ControlTemplate.Triggers>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsVisible" Value="True" />
            <Condition Property="IsIndeterminate" Value="True" />
          </MultiTrigger.Conditions>
          <MultiTrigger.EnterActions>
            <BeginStoryboard x:Name="LoadingRotation"><Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="Rotor"
                               Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                               From="0" To="360" Duration="0:0:1" />
            </Storyboard></BeginStoryboard>
          </MultiTrigger.EnterActions>
          <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="LoadingRotation" /></MultiTrigger.ExitActions>
        </MultiTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding IsWaitingForServer}" Value="True">
      <Setter Property="Visibility" Value="Visible" />
    </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="AccountCapsule" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" /><Setter Property="MaxWidth" Value="96" />
    <Setter Property="Padding" Value="14,5" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource AccountInkBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccountGuestBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccountGuestBorderBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Grid>
        <Border x:Name="FocusRing" Margin="-4" CornerRadius="22" BorderThickness="2"
                BorderBrush="{DynamicResource LoginFocusBrush}" Visibility="Collapsed">
          <Border CornerRadius="20" BorderThickness="2" BorderBrush="{DynamicResource LoginFocusSeparationBrush}" />
        </Border>
        <Border x:Name="Shadow" Background="{TemplateBinding Background}" CornerRadius="18">
          <Border.Effect><DropShadowEffect Color="#263841" Opacity="0.10" BlurRadius="2" ShadowDepth="1" Direction="270" /></Border.Effect>
        </Border>
        <Border x:Name="CapsuleBody" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="Highlight" Margin="1" CornerRadius="17" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource LoginHighlightBrush}" Opacity="0.96" IsHitTestVisible="False" />
        <Border x:Name="Inset" Margin="1" CornerRadius="17" BorderThickness="0,1,0,0"
                BorderBrush="#1A263841" Visibility="Collapsed" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Shadow" Property="Effect"><Setter.Value>
            <DropShadowEffect Color="#263841" Opacity="0.14" BlurRadius="4" ShadowDepth="2" Direction="270" />
          </Setter.Value></Setter>
        </Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.7" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Inset" Property="Visibility" Value="Visible" />
          <Setter TargetName="Highlight" Property="BorderThickness" Value="0,0,0,1" />
          <Setter TargetName="Highlight" Property="Opacity" Value="0.7" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
        <Setter Property="MinWidth" Value="144" /><Setter Property="MaxWidth" Value="224" />
        <Setter Property="Padding" Value="10,5" />
      </DataTrigger>
      <DataTrigger Binding="{Binding AccountState}" Value="online">
        <Setter Property="Background" Value="{DynamicResource AccountOnlineBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOnlineBorderBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding AccountState}" Value="offline">
        <Setter Property="Background" Value="{DynamicResource AccountOfflineBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOfflineBorderBrush}" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="guest" />
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountGuestHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountGuestHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="online" />
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountOnlineHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOnlineHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="offline" />
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountOfflineHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOfflineHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="guest" />
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource AccountGuestHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="online" />
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOnlineHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="offline" />
          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOfflineHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="guest" />
          <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountGuestActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountGuestActiveBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="online" />
          <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountOnlineActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOnlineActiveBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="offline" />
          <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountOfflineActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOfflineActiveBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="guest" />
          <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountGuestPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountGuestActiveBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="online" />
          <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountOnlinePressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOnlineActiveBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AccountState}" Value="offline" />
          <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource AccountOfflinePressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccountOfflineActiveBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccountEmphasisBrush}" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
