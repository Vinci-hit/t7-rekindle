<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Lucide 1.8.0 paths; ISC/Feather notices are embedded in THIRD-PARTY-NOTICES.txt. -->
  <Geometry x:Key="LoginIcon.User">M17 8 A5 5 0 1 1 7 8 A5 5 0 1 1 17 8 M20 21a8 8 0 0 0-16 0</Geometry>
  <Geometry x:Key="LoginIcon.Chevron">M6 9l6 6 6-6</Geometry>
  <Geometry x:Key="LoginIcon.Logout">M16 17l5-5-5-5 M21 12H9 M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4</Geometry>
  <Geometry x:Key="LoginIcon.Reload">M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8 M21 3v5h-5</Geometry>
  <Geometry x:Key="LoginIcon.External">M15 3h6v6 M10 14L21 3 M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6</Geometry>
  <Geometry x:Key="LoginIcon.Close">M18 6L6 18 M6 6l12 12</Geometry>
  <Geometry x:Key="LoginIcon.Minus">M5 12h14</Geometry>
  <Geometry x:Key="LoginIcon.Window">M4 4H20a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z M10 4v4 M2 8h20 M6 4v4</Geometry>
  <Style x:Key="LoginGlyph" TargetType="Control">
    <Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" />
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
      <Viewbox><Canvas Width="24" Height="24">
        <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Canvas></Viewbox>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LoginKeyboardFocus">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border Margin="-4" CornerRadius="9" BorderThickness="2" BorderBrush="{DynamicResource LoginFocusBrush}">
        <Border CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource LoginFocusSeparationBrush}" />
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LoginIconButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LoginMutedBrush}" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource LoginKeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource LoginIconHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LoginIconBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LoginInkBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource LoginIconPressedBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="LoginLogoutButton" TargetType="Button" BasedOn="{StaticResource LoginIconButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource LoginLogoutHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LoginLogoutBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LoginDangerBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource LoginLogoutPressedBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="LoginActionButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" /><Setter Property="MinWidth" Value="116" />
    <Setter Property="Padding" Value="16,0" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="{DynamicResource LoginActionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LoginActionBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LoginInkBrush}" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource LoginKeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="Shadow" Background="{TemplateBinding Background}" CornerRadius="6">
          <Border.Effect><DropShadowEffect Color="#24363B" Opacity="0.12" BlurRadius="3" ShadowDepth="1" Direction="270" /></Border.Effect>
        </Border>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
        <Border x:Name="Highlight" Margin="1" CornerRadius="5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LoginHighlightBrush}" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="Primary"><Setter TargetName="Highlight" Property="Opacity" Value="0.32" /></Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource LoginActionHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LoginActionHoverBorderBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource LoginActionPressedBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource LoginActionButton}">
    <Setter Property="Tag" Value="Primary" />
    <Setter Property="Background" Value="{DynamicResource LoginPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LoginPrimaryBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LoginPrimaryTextBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource LoginPrimaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LoginPrimaryHoverBorderBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource LoginPrimaryPressedBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
