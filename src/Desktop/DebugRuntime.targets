<Project>
  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(PythonHome)' != ''">
    <_T7RDebugPythonDll Include="$(PythonHome)\python314.dll;$(PythonHome)\python3.dll;$(PythonHome)\vcruntime140.dll;$(PythonHome)\vcruntime140_1.dll" />
    <None Include="@(_T7RDebugPythonDll->Exists())"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PythonHome)\DLLs\*.pyd;$(PythonHome)\DLLs\*.dll"
          Link="python\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PythonHome)\Lib\**\*"
          Exclude="$(PythonHome)\Lib\site-packages\**\*;$(PythonHome)\Lib\test\**\*;$(PythonHome)\Lib\**\__pycache__\**\*;$(PythonHome)\Lib\**\*.pyc"
          Link="python\Lib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="T7RValidateDebugRuntime" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems"
          Condition="'$(Configuration)' == 'Debug' and '$(PythonHome)' != '' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(PythonHome)\python314.dll')"
           Text="PythonHome must contain python314.dll for Debug startup." />
    <Error Condition="!Exists('$(PythonHome)\Lib\encodings\__init__.py')"
           Text="PythonHome must contain the development installation's Lib standard library for Debug startup." />
    <Error Condition="!Exists('$(PythonHome)\DLLs\_socket.pyd')"
           Text="PythonHome must contain the development installation's DLLs extensions for Debug startup." />
  </Target>
</Project>
